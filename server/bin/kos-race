#!/usr/bin/env bash
# kos-race — control the live race server's public status.
#
#   kos-race on|closed|hidden [message...]   set the status file (atomic write)
#   kos-race min <version> [proto]           refuse game builds older than <version> (e.g. 0.8.5); optional protocol level
#   kos-race min off                         lift the minimum again
#   kos-race min                             show the current minimum
#   kos-race status                          show status file (mode, message, minimum) + server health
#
# Env:
#   KOS_STATUS_FILE  status file path (default /var/www/html/mp-status.json)
#   KOS_HEALTH_URL   health endpoint (default http://127.0.0.1:8787/health)
#
# The status file is JSON:
#   {"mode":"on|closed|hidden","message":"...","maxRooms":40,"maxPlayers":24,"minClient":"0.8.5","minProto":2}
# maxRooms/maxPlayers/minClient/minProto are preserved from the existing file when present (defaults 40/24, no minimum);
# message defaults to the empty string. The server reads the file within seconds (fs.watch + 5 s poll): no restart needed.
# A client below minClient, or one that sends no version at all (v0.8.4 and older), is refused with "old" and the game
# tells the player to update. Raise the minimum between races: players already in a race are not touched, but a refused
# build cannot reconnect.
set -euo pipefail

STATUS_FILE="${KOS_STATUS_FILE:-/var/www/html/mp-status.json}"
HEALTH_URL="${KOS_HEALTH_URL:-http://127.0.0.1:8787/health}"

usage() {
  echo "usage: kos-race on|closed|hidden [message...] | kos-race min <version>|off [proto] | kos-race status" >&2
}

# Merge the requested change into the existing file (all values arrive via env vars, so quoting is safe) and replace it atomically.
#   KOS_OP=mode:  KOS_MODE, KOS_MESSAGE          KOS_OP=min:  KOS_MINVER ("off" clears), KOS_MINPROTO ("" keeps/clears with off)
write_status() {
  local dir tmp
  dir=$(dirname -- "$STATUS_FILE")
  tmp=$(mktemp -- "$dir/.kos-race.XXXXXX")
  if ! KOS_STATUS_FILE="$STATUS_FILE" node -e '
    const fs = require("fs");
    let o = {};
    try { const j = JSON.parse(fs.readFileSync(process.env.KOS_STATUS_FILE, "utf8")); if (j && typeof j === "object" && !Array.isArray(j)) o = j; } catch (e) { o = {}; }
    const pos = (v) => (Number.isFinite(v) && v > 0 ? Math.floor(v) : null);
    const out = {
      mode: ["on", "closed", "hidden"].indexOf(o.mode) >= 0 ? o.mode : "hidden",
      message: typeof o.message === "string" ? o.message : "",
      maxRooms: pos(o.maxRooms) || 40,
      maxPlayers: pos(o.maxPlayers) || 24
    };
    if (typeof o.minClient === "string" && o.minClient) out.minClient = o.minClient;
    if (pos(o.minProto)) out.minProto = pos(o.minProto);
    if (process.env.KOS_OP === "mode") {
      out.mode = process.env.KOS_MODE;
      out.message = process.env.KOS_MESSAGE || "";
    } else if (process.env.KOS_OP === "min") {
      if (process.env.KOS_MINVER === "off") { delete out.minClient; delete out.minProto; }
      else {
        out.minClient = process.env.KOS_MINVER;
        const p = parseInt(process.env.KOS_MINPROTO, 10);
        if (Number.isFinite(p) && p > 0) out.minProto = p;
      }
    }
    fs.writeFileSync(process.argv[1], JSON.stringify(out) + "\n");
  ' "$tmp"; then
    rm -f "$tmp"
    exit 1
  fi
  chmod 644 "$tmp"
  mv -f "$tmp" "$STATUS_FILE"
}

set_mode() {
  local mode="$1"
  shift
  KOS_OP=mode KOS_MODE="$mode" KOS_MESSAGE="$*" write_status
  echo "mode=$mode"
}

# kos-race min [<version>|off] [proto]
set_min() {
  if [ $# -eq 0 ]; then
    show_min
    return 0
  fi
  local ver="$1" proto="${2:-}"
  if [ "$ver" != "off" ] && ! [[ "$ver" =~ ^[0-9]{1,4}\.[0-9]{1,4}(\.[0-9]{1,4})?$ ]]; then
    echo "kos-race min: version must look like 0.8.5 (or 'off'), got '$ver'" >&2
    exit 2
  fi
  if [ -n "$proto" ] && ! [[ "$proto" =~ ^[0-9]{1,3}$ ]]; then
    echo "kos-race min: protocol level must be a number, got '$proto'" >&2
    exit 2
  fi
  KOS_OP=min KOS_MINVER="$ver" KOS_MINPROTO="$proto" write_status
  show_min
}

# prints minClient=... and minProto=... (or "none")
read_file() {
  KOS_STATUS_FILE="$STATUS_FILE" node -e '
    const fs = require("fs");
    let o = null;
    try { o = JSON.parse(fs.readFileSync(process.env.KOS_STATUS_FILE, "utf8")); } catch (e) { o = null; }
    const ok = o && typeof o === "object" && !Array.isArray(o);
    const mode = ok && ["on", "closed", "hidden"].indexOf(o.mode) !== -1 ? o.mode : "hidden (no status file)";
    const msg = ok && typeof o.message === "string" ? o.message.replace(/[\r\n]+/g, " ") : "";
    const mc = ok && typeof o.minClient === "string" && o.minClient ? o.minClient : "none";
    const mp = ok && Number.isFinite(o.minProto) && o.minProto > 0 ? String(Math.floor(o.minProto)) : "none";
    process.stdout.write("mode=" + mode + "\nmessage=" + msg + "\nminClient=" + mc + "\nminProto=" + mp + "\n");
  ' || true
}

show_min() {
  read_file | grep -E '^min(Client|Proto)='
}

show_status() {
  read_file

  local body=""
  if command -v curl >/dev/null 2>&1; then
    body=$(curl -s --max-time 2 "$HEALTH_URL" 2>/dev/null || true)
  fi
  if [ -z "$body" ]; then
    echo "server: not reachable"
    return 0
  fi
  KOS_HEALTH_BODY="$body" node -e '
    let o = null;
    try { o = JSON.parse(process.env.KOS_HEALTH_BODY); } catch (e) { o = null; }
    if (o && typeof o === "object" && !Array.isArray(o)) {
      const f = (k) => (o[k] === undefined || o[k] === null ? "-" : String(o[k]));
      process.stdout.write(
        "rooms=" + f("rooms") + "\n" +
        "players=" + f("players") + "\n" +
        "conns=" + f("conns") + "\n" +
        "rssMb=" + f("rssMb") + "\n" +
        "uptimeS=" + f("uptimeS") + "\n"
      );
    } else {
      process.stdout.write("server: bad health response\n");
    }
  '
}

# --- dispatch ----------------------------------------------------------------

cmd=${1:-}
case "$cmd" in
  on|closed|hidden)
    shift
    set_mode "$cmd" "$@"
    ;;
  min)
    shift
    set_min "$@"
    ;;
  status)
    show_status
    ;;
  *)
    usage
    exit 2
    ;;
esac
